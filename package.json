{
  "name": "zenmarket",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:undef": "node scripts/scan-no-undef.mjs",
    "format": "prettier --write \"src/**/*.{js,css}\" \"web/**/*.html\" \"scripts/**/*.mjs\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"web/**/*.html\" \"scripts/**/*.mjs\" \"*.md\" \"*.json\"",
    "strip:comments": "node scripts/strip-comments.mjs",
    "prebuild": "node scripts/gen-sitemap.mjs",
    "verify": "npm run lint:undef && npm run format:check && npm run build"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@fontsource/prompt": "^5.2.8",
    "@supabase/supabase-js": "^2.80.0",
    "lucide": "^0.468.0",
    "qrcode": "^1.5.4"
  }
}
