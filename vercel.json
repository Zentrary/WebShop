{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com https://*.supabase.co wss://*.supabase.co; object-src 'none'; media-src 'self' blob: manifest-src 'self' worker-src 'self' blob: script-src-attr 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/home",
      "statusCode": 308
    },
    {
      "source": "/index.html",
      "destination": "/home",
      "statusCode": 308
    },
    { "source": "/shop.html", "destination": "/shop", "statusCode": 308 },
    { "source": "/product.html", "destination": "/shop/product", "statusCode": 308 },
    { "source": "/categories.html", "destination": "/shop", "statusCode": 308 },
    { "source": "/cart.html", "destination": "/shop/cart", "statusCode": 308 },
    { "source": "/checkout.html", "destination": "/shop/checkout", "statusCode": 308 },
    { "source": "/account.html", "destination": "/account", "statusCode": 308 },
    { "source": "/orders.html", "destination": "/account/orders", "statusCode": 308 },
    { "source": "/order.html", "destination": "/account/order", "statusCode": 308 },
    { "source": "/favorites.html", "destination": "/account/favorites", "statusCode": 308 },
    { "source": "/login.html", "destination": "/auth/login", "statusCode": 308 },
    { "source": "/register.html", "destination": "/auth/register", "statusCode": 308 },
    { "source": "/reset-password.html", "destination": "/auth/reset-password", "statusCode": 308 },
    { "source": "/forgot-password.html", "destination": "/auth/forgot-password", "statusCode": 308 },
    { "source": "/about.html", "destination": "/pages/about", "statusCode": 308 },
    { "source": "/help.html", "destination": "/pages/help", "statusCode": 308 },
    { "source": "/privacy.html", "destination": "/pages/privacy", "statusCode": 308 },
    { "source": "/contact.html", "destination": "/pages/contact", "statusCode": 308 },
    { "source": "/admin", "destination": "/admin/dashboard", "statusCode": 308 },
    { "source": "/shop/categories", "destination": "/shop", "statusCode": 308 },
    { "source": "/shop/index", "destination": "/shop", "statusCode": 308 },
    { "source": "/account/index", "destination": "/account", "statusCode": 308 }
  ]
}
